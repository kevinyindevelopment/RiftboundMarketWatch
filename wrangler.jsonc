{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "riftmarket",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-04-15",
	// nodejs_compat: Node built-ins the Next server + Prisma adapter need.
	// global_fetch_strictly_public: OpenNext's required fetch semantics.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Durable cache for the homepage query results. This is a COST control, not a
	// speed one: an uncached render wakes Neon for the 5-minute scale-to-zero
	// window (see COST.md). The Workers Cache API was tried first and measured
	// unreliable — it evicted between requests and fell through to the database
	// roughly half the time. KV is globally replicated and actually retains.
	// Traffic here is ~24 writes/day and a handful of reads: far inside free tier.
	"kv_namespaces": [
		{
			"binding": "RIFTMARKET_CACHE",
			"id": "f8bb3b930c424ff98d35719ee71d2d75"
		}
	],
	// Keep the free riftmarket.<subdomain>.workers.dev URL alive alongside the
	// custom route — it's the runtime smoke-test target before DNS is wired.
	"workers_dev": true,
	// Serve only the /riftmarket path of the apex. /riftelo belongs to the
	// ratings Worker and the rest of kevin-yin.com is left free. Enable after the
	// workers.dev runtime check passes.
	"routes": [
		{ "pattern": "kevin-yin.com/riftmarket*", "zone_name": "kevin-yin.com" }
	]
}
