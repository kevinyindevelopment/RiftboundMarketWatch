# Copy to .env and fill in. `npm run snapshot` needs NONE of this (it writes JSON);
# only the Postgres ingest and the app itself need the database URLs.

# Neon Postgres. Two connection strings, both from the Neon dashboard:
#   DATABASE_URL        — POOLED (host contains "-pooler"). Used by the app.
#   DIRECT_DATABASE_URL — DIRECT (no "-pooler"). Used by the CLI ingest scripts
#                         and by `prisma db push` / migrations.
DATABASE_URL=""
DIRECT_DATABASE_URL=""

# Upstream data sources. Defaults are correct; override only for testing.
# TCGCSV_BASE="https://tcgcsv.com/tcgplayer"
# RIFTCODEX_BASE="https://api.riftcodex.com"
