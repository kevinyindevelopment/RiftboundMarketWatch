// Riftbound Market Watch — data model
//
// Card + product metadata comes from TCGplayer (via tcgcsv.com) enriched with
// Riftcodex; prices are a daily snapshot per (product, printing).

generator client {
  provider = "prisma-client-js"
  // Default output (node_modules/@prisma/client) — deliberately NOT a custom
  // output into src/: a local client gets inlined by `next build` with the Node
  // export condition, so on Cloudflare Workers it wrongly tries to read the wasm
  // from disk. As a real package listed in `serverExternalPackages`, Next leaves
  // it external and OpenNext resolves the "workerd" condition.
  //
  // engineType = "client": the GA query compiler — WASM, no native Rust engine,
  // so there's no per-platform binaryTarget to mismatch. Requires a driver
  // adapter, and we always pass the Neon one. See src/lib/prisma.ts.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations / introspection use the direct (non-pooler) connection.
  directUrl = env("DIRECT_DATABASE_URL")
}

/// A Riftbound set / product line, as TCGplayer groups them.
model CardSet {
  // TCGplayer groupId — the natural key upstream, so we reuse it rather than
  // minting our own and having to maintain a mapping.
  groupId        Int      @id
  name           String
  abbreviation   String?  // "OGN", "UNL", "VEN", ...
  publishedOn    DateTime?
  isSupplemental Boolean  @default(false)

  products Product[]

  @@index([publishedOn])
}

/// One TCGplayer listing: either a single card or a sealed item.
///
/// Singles and sealed live in ONE table because prices attach to a TCGplayer
/// product id regardless of what it is, and the market view wants both ("what's
/// a Vendetta booster box worth" is as much a market question as a chase rare).
/// `isSealed` splits them for the card-database views.
model Product {
  // TCGplayer productId — also the join key for every price row.
  productId    Int     @id
  name         String
  cleanName    String
  isSealed     Boolean @default(false)
  tcgplayerUrl String
  imageUrl     String?
  releasedOn   DateTime?

  groupId Int
  set     CardSet @relation(fields: [groupId], references: [groupId], onDelete: Cascade)

  // --- TCGplayer extendedData (singles only; null on sealed) ---
  rarity      String?
  number      String? // printed collector number, e.g. "SP3/006"
  cardType    String? // "Champion Unit", "Legend", "Spell", ...
  description String? // rules text
  energyCost  String?
  powerCost   String?
  might       String?
  domain      String?
  tags        String? // ";"-separated upstream, kept verbatim

  // --- Riftcodex enrichment, joined on tcgplayer_id ---
  riftcodexId      String?
  riftboundId      String? // canonical id, e.g. "unl-229*-219"
  setCode          String? // "UNL"
  collectorNumber  Int?
  artist           String?
  flavour          String?
  officialImageUrl String? // Riot CMS art (higher quality than TCGplayer's 200w)
  isAlternateArt   Boolean?
  isSignature      Boolean?
  /// Collector number exceeds the set size (e.g. 187/166). A distinct printing
  /// and a distinct market — and it composes with `isSignature`, so an
  /// "overnumbered signature" is its own thing again. See src/lib/grading.ts.
  isOvernumbered   Boolean?
  /// "tcgplayer_id" | "riftbound_id" | null — how the Riftcodex row was matched.
  /// Kept so a bad fallback join can be found and audited later.
  joinedBy         String?

  firstSeenAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Sales-derived price for the PRIMARY variant ---
  // Denormalised so listing pages can sort without aggregating sales per row.
  // This is ONE variant's price — the most-traded (finish, grade) bucket, named
  // by `salePriceVariant`. The full per-variant breakdown lives in ProductPrice;
  // never present this number without saying which variant it describes.
  salePrice        Float?
  salePriceLow     Float?
  salePriceHigh    Float?
  saleSampleSize   Int?
  saleLastAt       DateTime?
  salePriceAt      DateTime?
  /// e.g. "Foil:raw" — which bucket `salePrice` came from.
  salePriceVariant String?

  prices        PriceSnapshot[]
  sales         Sale[]
  variantPrices ProductPrice[]
  listings      Listing[]

  @@index([groupId])
  @@index([isSealed])
  @@index([rarity])
  @@index([riftboundId])
  @@index([name])
}

/// One day's TCGplayer price for one printing of one product.
///
/// The PK is (productId, subTypeName, date): a product can be listed as both
/// Normal and Foil at different prices, so productId alone is NOT unique — and
/// re-running the ingest on the same day must overwrite, not duplicate.
///
/// `date` is the UTC day (see collect.ts:utcDay). tcgcsv refreshes ~20:00 UTC and
/// its price payload carries no timestamp of its own, so we stamp our own.
model PriceSnapshot {
  productId   Int
  product     Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  subTypeName String  // "Normal" | "Foil"
  date        DateTime @db.Date

  lowPrice       Float?
  midPrice       Float?
  highPrice      Float?
  // The headline number: TCGplayer's market price (what it actually sells for).
  marketPrice    Float?
  directLowPrice Float?

  @@id([productId, subTypeName, date])
  // Serves "price history for this product" (leading productId) and, separately,
  // "everything that moved on day X" for the movers board.
  @@index([date])
}

/// A single completed TCGplayer sale ("Latest Sales" on the product page).
///
/// WHY WE ACCUMULATE THESE. The upstream endpoint returns only the **5 most
/// recent** sales per product — `limit` and `offset` are both ignored, so a
/// deeper history cannot be fetched on demand. Polling hourly and storing what's
/// new builds the depth ourselves: after a day, an active card has far more than
/// the 10 sales the price is computed from.
///
/// Caveat that follows from that: a card selling more than 5 times within one
/// polling interval will lose the oldest of those sales permanently. At the
/// observed rate (a hot chase card managed 5 sales in ~5 hours) that's rare, but
/// it is why the poller runs hourly rather than daily.
model Sale {
  /// Deterministic hash of the natural key. The feed carries no sale id
  /// (`customListingId` is the listing, not the sale, and repeats), so identity
  /// is the tuple below — that's what makes re-polling idempotent.
  id String @id

  productId Int
  product   Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  orderDate     DateTime
  purchasePrice Float   // per unit, excluding shipping
  shippingPrice Float
  quantity      Int
  condition     String  // "Near Mint" | "Lightly Played" | "Unopened" | ...
  /// Finish: "Normal" | "Foil". A PRICING AXIS, not a label — measured across
  /// 360 products the foil traded up to 18x the normal, so a blended median
  /// describes neither.
  variant       String
  /// Grading bucket from src/lib/grading.ts: "raw", "PSA10", "BGS10-BLACK", …
  /// Always "raw" for TCGplayer, which sells ungraded singles.
  gradeKey      String  @default("raw")
  /// Where the sale came from: "tcgplayer" | "ebay".
  source        String  @default("tcgplayer")
  language      String?
  title         String?

  seenAt DateTime @default(now()) // when our poller first observed it

  // Drives the price computation: newest-first within a product+variant bucket,
  // and the condition filter that keeps Lightly Played out of the headline.
  @@index([productId, variant, gradeKey, condition, orderDate])
  @@index([orderDate])
}

/// The price of ONE variant of a product — a (finish, grade) pair.
///
/// This table exists because "the price of a card" is not a single number.
/// Measured on real data: foils traded up to 18x their normal counterpart across
/// 360 products, and a PSA 10 is a different market again from the same card
/// raw. Collapsing those into one median produces a figure that describes no
/// purchasable item.
model ProductPrice {
  productId Int
  product   Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  /// "Normal" | "Foil"
  finish    String
  /// "raw" | "PSA10" | "BGS10-BLACK" | "CGC10-PRISTINE" | …
  gradeKey  String

  price      Float
  low        Float
  high       Float
  sampleSize Int
  lastSaleAt DateTime
  computedAt DateTime @default(now())
  /// "tcgplayer" | "ebay" — which marketplace's sales produced this.
  source     String   @default("tcgplayer")

  @@id([productId, finish, gradeKey])
  @@index([price])
}

/// An active TCGplayer listing — someone's current ask.
///
/// Ephemeral by nature: listings sell and get relisted constantly, so each poll
/// REPLACES a product's rows rather than accumulating them. This is the opposite
/// of `Sale`, which is an immutable historical record we deliberately build up.
/// Storing listing history would be a much larger table describing a market that
/// no longer exists.
///
/// Only the cheap end of each product is kept — a deal lives there by
/// definition, and one common had 880 live listings.
model Listing {
  /// TCGplayer's own listing id.
  listingId BigInt @id

  productId Int
  product   Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  /// "Normal" | "Foil" — must match the finish of the price it's compared to.
  finish        String
  condition     String
  language      String
  price         Float
  shippingPrice Float
  quantity      Int

  /// "standard" | "custom". Only `standard` listings are guaranteed to BE the
  /// catalogue product — sellers use custom listings to sell physically
  /// different items (Chinese slim/jumbo boxes) under the same product page.
  /// Custom listings are filtered out at ingest; the column is kept so the
  /// decision is auditable rather than invisible.
  listingType  String  @default("standard")
  customTitle  String?

  sellerName   String?
  sellerRating Float?
  sellerSales  String?
  directSeller Boolean @default(false)

  seenAt DateTime @default(now())

  /// Serves the deals query: cheapest comparable listing per product+finish.
  @@index([productId, finish, price])
  @@index([seenAt])
}

/// One row per completed ingest — so the site can show "last updated" and so a
/// backfill can tell which days it already has without scanning PriceSnapshot.
model IngestRun {
  id            Int      @id @default(autoincrement())
  date          DateTime @db.Date
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  setCount      Int      @default(0)
  productCount  Int      @default(0)
  priceRowCount Int      @default(0)
  source        String   @default("daily") // "daily" | "backfill"
  ok            Boolean  @default(false)
  note          String?

  @@index([date])
}
